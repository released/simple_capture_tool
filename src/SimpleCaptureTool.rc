#include "resource.h"
#include "tool_build_identity.h"
#include <windows.h>
#include "version.h"
#pragma code_page(65001)
#include <afxres.rc>

IDI_APP_ICON ICON "res\\SimpleCaptureTool.ico"

1 VERSIONINFO
 FILEVERSION TOOL_BUILD_VERSION_NUMERIC
 PRODUCTVERSION TOOL_BUILD_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Simple Capture Tool"
   VALUE "FileVersion", TOOL_BUILD_VERSION_TEXT
   VALUE "ProductName", "Simple Capture Tool"
   VALUE "ProductVersion", TOOL_BUILD_VERSION_TEXT
            VALUE "BuildDateTime", TOOL_BUILD_TIMESTAMP_ISO "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

