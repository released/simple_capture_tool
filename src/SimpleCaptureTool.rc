#include "resource.h"
#include <windows.h>
#include "version.h"
#pragma code_page(65001)
#include <afxres.rc>

IDI_APP_ICON ICON "res\\SimpleCaptureTool.ico"

1 VERSIONINFO
 FILEVERSION SCT_VERSION_NUM
 PRODUCTVERSION SCT_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Simple Capture Tool"
   VALUE "FileVersion", SCT_VERSION
   VALUE "ProductName", "Simple Capture Tool"
   VALUE "ProductVersion", SCT_VERSION
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

